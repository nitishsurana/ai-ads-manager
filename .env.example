# Copy to .env.local and fill in. Never commit .env.local.

# Vercel AI Gateway (Claude, GPT, Gemini)
AI_GATEWAY_API_KEY=

# Fal (cut-outs and backgrounds)
FAL_KEY=

# Supabase (Project Settings > API keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Firecrawl (page rendering and research fallback)
FIRECRAWL_API_KEY=

# Tester access
TESTER_PASSWORD=
# Signs the tester session cookie: npm run secrets
SESSION_SECRET=

# Admin view sign-in (separate from testers)
ADMIN_PASSWORD=

# Supabase Postgres connection string, for running migrations (Project Settings > Database > Connection string, Session pooler)
SUPABASE_DB_URL=

# Daily spend cap across all model and image calls, in USD
SPEND_CAP_USD_DAILY=5

# Protects the daily Supabase keep-alive cron: npm run secrets
CRON_SECRET=
